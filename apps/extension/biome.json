{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"root": false,
	"extends": "//",
	"overrides": [
		{
			"includes": ["**/*.svelte"],
			"formatter": { "enabled": false },
			"assist": { "enabled": false },
			"linter": {
				"rules": {
					"style": { "useConst": "off", "useImportType": "off" },
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off"
					}
				}
			}
		}
	]
}
